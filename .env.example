# SPDX-License-Identifier: GPL-3.0-or-later
# Secret key for Fernet encryption of LMS tokens, L2 cache, and private blobs at rest
DOOMED_SECRET_KEY=change-me-to-a-32-byte-secret-passphrase

# OpenAI-compatible LLM configuration (OmniRoute localhost / OpenRouter / Gemini)
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
TEACHER_MODEL=agy/gemini-3.8-flash-high
MAKER_MODEL=agy/gemini-3.8-flash-high
RESEARCHER_MODEL=agy/gemini-3.8-flash-high

# Indus LMS optional token path (auto-imported on local startup if present)
INDUSLMS_TOKEN_FILE=~/.induslms_token.json

# Personal mode: sign in automatically from the local token file.
# Only takes effect for requests coming from 127.0.0.1. Leave this off when
# the app is reachable from another machine.
DOOMED_AUTO_BOOTSTRAP_TOKEN=1

# Browser origins allowed to make credentialed requests
DOOMED_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# IB Resource Catalog Sidecar (default: public hosted catalog)
IB_SCRAPE_BASE_URL=https://ib-scrape.sidevv.xyz

# Storage & Cache Limits
DOOMED_DATA_DIR=./data
DOOMED_DATA_TTL=300
DOOMED_FILES_TTL=3600
DOOMED_DETAIL_TTL=300
DOOMED_MAX_FILE_BYTES=26214400
DOOMED_MAX_PRIVATE_CACHE_MB=512
DOOMED_MAX_IB_CACHE_MB=1024

# Adaptive practice feed (opt-in; leave off until a verified item pool exists)
DOOMED_PRACTICE_ENGINE=0
DOOMED_HOME_FEED=0
DOOMED_ITEM_GENERATION=0
DOOMED_DAILY_CARDS=12
DOOMED_TARGET_RETENTION=0.90

# Optional school LMS plugin. Set to 0 for a purely local build.
DOOMED_LMS_PLUGIN=1
